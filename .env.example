# Cấu hình Gmail SMTP để gửi mã OTP thật về hộp thư Gmail
# Hướng dẫn lấy App Password 16 ký tự của Google:
# 1. Vào Google Account -> Security -> Bật 2-Step Verification
# 2. Tìm "App Passwords" -> Tạo mật khẩu ứng dụng 16 ký tự
SMTP_EMAIL=your_gmail@gmail.com
SMTP_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

VITE_API_URL=http://localhost:5080
